// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  professional
  student
}

model User {
  id              String            @id @default(uuid())
  name            String
  email           String            @unique
  emailVerified   Boolean           @default(false) @map("email_verified")
  image           String?
  type            UserType
  crmv            String?
  crmvActivatedAt DateTime?         @map("crmv_activated_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  sessions        Session[]
  accounts        Account[]
  guardians       Guardian[]
  patients        Patient[]
  visits          Visit[]
  medications     Medication[]
  vaccines        Vaccine[]
  attachments     Attachment[]
  consents        GuardianConsent[]
  shares          Share[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// A escala do escore corporal muda com a espécie.
// 1 a 9: cão, gato (WSAVA) e equino (Henneke). 1 a 5: produção, aves, exóticos.
enum BodyConditionScale {
  nine_point
  five_point
}

model Species {
  id                 String             @id @default(uuid())
  name               String             @unique
  bodyConditionScale BodyConditionScale @default(nine_point) @map("body_condition_scale")
  breeds             Breed[]

  @@map("species")
}

model Breed {
  id        String    @id @default(uuid())
  name      String
  speciesId String    @map("species_id")
  species   Species   @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  patients  Patient[]

  @@unique([speciesId, name])
  @@map("breeds")
}

enum PatientSex {
  male
  female
}

// Tutor do animal. "Guardian" e não "owner", porque o dono do registro é o usuário (userId).
model Guardian {
  id        String            @id @default(uuid())
  userId    String            @map("user_id")
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  name      String
  phone     String
  email     String
  cpf       String? // só os 11 dígitos
  birthDate DateTime          @map("birth_date") @db.Date
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  addresses GuardianAddress[]
  patients  Patient[]
  consents  GuardianConsent[]
  shares    Share[]

  // O mesmo CPF não repete entre os tutores de um usuário. O Postgres aceita vários NULL.
  @@unique([userId, cpf])
  @@index([userId])
  @@map("guardians")
}

// Histórico de endereços. Só um tem current = true.
model GuardianAddress {
  id         String   @id @default(uuid())
  guardianId String   @map("guardian_id")
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  zipCode    String   @map("zip_code")
  current    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([guardianId])
  @@map("guardian_addresses")
}

model Patient {
  id         String            @id @default(uuid())
  userId     String            @map("user_id")
  user       User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  guardianId String?           @map("guardian_id")
  guardian   Guardian?         @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  breedId    String            @map("breed_id")
  breed      Breed             @relation(fields: [breedId], references: [id], onDelete: Restrict)
  name       String
  sex        PatientSex
  neutered   Boolean           @default(false)
  coatColor  String?           @map("coat_color")
  birthDate  DateTime          @map("birth_date") @db.Date
  microchip  String?
  photoKey   String?           @map("photo_key")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  visits     Visit[]
  vaccines   Vaccine[]
  consents   GuardianConsent[]
  shareItems ShareItem[]

  // Único por usuário: o mesmo animal pode ter cadastro em 2 clínicas
  @@unique([userId, microchip])
  @@index([userId])
  @@index([guardianId])
  @@map("patients")
}

// Atendimento. O userId é o autor (criado_por do DER) e também o escopo.
model Visit {
  id                 String              @id @default(uuid())
  userId             String              @map("user_id")
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Snapshot do tipo do autor no momento da criação. Nunca muda.
  authorType         UserType            @map("author_type")
  patientId          String              @map("patient_id")
  patient            Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visitedAt          DateTime            @map("visited_at")
  weightKg           Float?              @map("weight_kg")
  temperatureC       Float?              @map("temperature_c")
  heartRate          Int?                @map("heart_rate")
  respiratoryRate    Int?                @map("respiratory_rate")
  // Escore corporal. A escala vai junto: um 5 na escala de 1 a 5 é obeso,
  // e na de 1 a 9 é ideal. Ela vem da espécie no momento do registro.
  bodyConditionScore Float?              @map("body_condition_score")
  bodyConditionScale BodyConditionScale? @map("body_condition_scale")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  soap               VisitSoap?
  medications        Medication[]
  vaccines           Vaccine[]
  attachments        Attachment[]

  @@index([userId])
  @@index([patientId, visitedAt])
  @@map("visits")
}

// 1:1 com o atendimento. A chave é o próprio visitId.
model VisitSoap {
  visitId    String  @id @map("visit_id")
  visit      Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  subjective String?
  objective  String?
  assessment String?
  plan       String?

  @@map("visit_soaps")
}

enum MedicationRoute {
  oral
  topical
  subcutaneous
  intramuscular
  intravenous
  ophthalmic
  otic
  rectal
  inhalation
  other
}

// Medicação prescrita num atendimento. O histórico do paciente sai pelo atendimento
// (Paciente -> Atendimento -> Medicação), sem FK direta para o paciente.
model Medication {
  id            String          @id @default(uuid())
  userId        String          @map("user_id")
  user          User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  visitId       String          @map("visit_id")
  visit         Visit           @relation(fields: [visitId], references: [id], onDelete: Restrict)
  name          String
  dosage        String
  frequency     String
  route         MedicationRoute
  startDate     DateTime        @map("start_date") @db.Date
  endDate       DateTime?       @map("end_date") @db.Date
  continuousUse Boolean         @default(false) @map("continuous_use")
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([userId])
  @@index([visitId])
  @@map("medications")
}

// Vacina aplicada. O atendimento é opcional: uma vacina antiga, de antes do paciente
// entrar no sistema, entra sem atendimento. Por isso ela aponta direto para o paciente.
model Vaccine {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  patientId    String    @map("patient_id")
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visitId      String?   @map("visit_id")
  visit        Visit?    @relation(fields: [visitId], references: [id], onDelete: Restrict)
  name         String
  appliedAt    DateTime  @map("applied_at") @db.Date
  nextDoseAt   DateTime? @map("next_dose_at") @db.Date
  manufacturer String?
  batch        String?
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([userId, nextDoseAt])
  @@index([patientId])
  @@index([visitId])
  @@map("vaccines")
}

// Tipo do anexo (exame, laudo, radiografia...). Catálogo global, gerenciado pelo seed.
model AttachmentType {
  id          String       @id @default(uuid())
  name        String       @unique
  attachments Attachment[]

  @@map("attachment_types")
}

// Arquivo clínico ligado a um atendimento. O arquivo fica no storage (R2 ou disco),
// e aqui fica só a referência (storageKey).
model Attachment {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  visitId     String         @map("visit_id")
  visit       Visit          @relation(fields: [visitId], references: [id], onDelete: Restrict)
  typeId      String         @map("type_id")
  type        AttachmentType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  fileName    String         @map("file_name")
  contentType String         @map("content_type")
  sizeBytes   Int            @map("size_bytes")
  storageKey  String         @unique @map("storage_key")
  description String?
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([userId])
  @@index([visitId])
  @@map("attachments")
}

// Autorização do tutor para compartilhar o paciente com terceiros (estudo).
// Tem peso legal: nunca é apagada. Revogar só preenche o revokedAt.
model GuardianConsent {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  guardianId  String    @map("guardian_id")
  guardian    Guardian  @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  patientId   String    @map("patient_id")
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  termVersion String    @map("term_version")
  acceptedAt  DateTime  @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([patientId])
  @@map("guardian_consents")
}

enum ShareType {
  guardian // o tutor vê o próprio animal
  third_party // estudante ou outro profissional. Exige consentimento do tutor
}

// Código de acesso somente leitura, criado pelo veterinário.
// Revogar só preenche o revokedAt. O limite de usos é contado em ShareUse.
model Share {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  type          ShareType
  // Só no tipo guardian: o tutor que recebe o código
  guardianId    String?     @map("guardian_id")
  guardian      Guardian?   @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  code          String      @unique
  recipientName String?     @map("recipient_name")
  expiresAt     DateTime    @map("expires_at")
  maxUses       Int?        @map("max_uses")
  revokedAt     DateTime?   @map("revoked_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  items         ShareItem[]
  uses          ShareUse[]

  @@index([userId])
  @@map("shares")
}

// N:N entre compartilhamento e paciente
model ShareItem {
  shareId   String  @map("share_id")
  share     Share   @relation(fields: [shareId], references: [id], onDelete: Cascade)
  patientId String  @map("patient_id")
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@id([shareId, patientId])
  @@map("share_items")
}

// Cada acesso pelo código. Serve para o limite de usos e para a auditoria.
model ShareUse {
  id        String   @id @default(uuid())
  shareId   String   @map("share_id")
  share     Share    @relation(fields: [shareId], references: [id], onDelete: Cascade)
  usedAt    DateTime @default(now()) @map("used_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  @@index([shareId])
  @@map("share_uses")
}
