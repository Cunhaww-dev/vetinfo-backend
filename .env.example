PORT=3334
# Em produção, use NODE_ENV=production. Com ele, o Swagger (/docs) não sobe.
NODE_ENV=development
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5433/NOME_DO_BANCO?schema=public
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3334
